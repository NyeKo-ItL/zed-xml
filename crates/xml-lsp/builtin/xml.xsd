<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema of the XML namespace (http://www.w3.org/XML/1998/namespace): the
  attributes xml:lang, xml:space, xml:base and xml:id defined by the XML and
  xml:id specifications, written for this project. It stands in for the
  W3C document usually imported from http://www.w3.org/2001/xml.xsd, which
  the server never downloads.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/XML/1998/namespace"
           xml:lang="en">

  <xs:attribute name="lang">
    <xs:annotation>
      <xs:documentation>Language of the content of the element (BCP 47 tag, or the empty string to reset it).</xs:documentation>
    </xs:annotation>
    <xs:simpleType>
      <xs:union memberTypes="xs:language">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value=""/>
          </xs:restriction>
        </xs:simpleType>
      </xs:union>
    </xs:simpleType>
  </xs:attribute>

  <xs:attribute name="space">
    <xs:annotation>
      <xs:documentation>Whitespace handling intended for the content of the element: default or preserve.</xs:documentation>
    </xs:annotation>
    <xs:simpleType>
      <xs:restriction base="xs:NCName">
        <xs:enumeration value="default"/>
        <xs:enumeration value="preserve"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>

  <xs:attribute name="base" type="xs:anyURI">
    <xs:annotation>
      <xs:documentation>Base URI used to resolve the relative URIs in the scope of the element.</xs:documentation>
    </xs:annotation>
  </xs:attribute>

  <xs:attribute name="id" type="xs:ID">
    <xs:annotation>
      <xs:documentation>Unique identifier of the element (xml:id).</xs:documentation>
    </xs:annotation>
  </xs:attribute>

  <xs:attributeGroup name="specialAttrs">
    <xs:attribute ref="xml:base"/>
    <xs:attribute ref="xml:lang"/>
    <xs:attribute ref="xml:space"/>
  </xs:attributeGroup>

</xs:schema>
