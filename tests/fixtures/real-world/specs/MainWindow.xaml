<!-- WPF XAML window (https://learn.microsoft.com/dotnet/desktop/wpf/xaml/):
     default presentation namespace, the x: language namespace, markup
     extensions in attribute values and property elements. -->
<Window x:Class="Fixtures.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fixtures"
        Title="Orders" Height="350" Width="525">
    <Window.Resources>
        <local:PriceConverter x:Key="PriceConverter"/>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#FF2A6FDB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="Orders" ItemsSource="{Binding Orders}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Customer" DisplayMemberBinding="{Binding Customer}"/>
                    <GridViewColumn Header="Total" DisplayMemberBinding="{Binding Total, Converter={StaticResource PriceConverter}}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Grid.Row="1" x:Name="Save" Content="_Save" Style="{StaticResource Primary}"/>
    </Grid>
</Window>
